{
  "manifest_version": 3,
  "name": "Omakeep",
  "version": "0.1.0",
  "description": "Save the current page to your local Omakeep library.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "favicon"
  ],
  "action": {
    "default_title": "Save to Omakeep (Alt+Shift+K)"
  },
  "commands": {
    "save-bookmark": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Save page to Omakeep"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
